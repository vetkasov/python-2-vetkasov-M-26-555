[0.262, "o", "***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n"]
[0.262, "o", "Введите команду: "]
[1.0673, "o", "create_table users name:str age:int is_active:bool\r\n"]
[1.0683, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[1.0683, "o", "Введите команду: "]
[1.8735, "o", "list_tables\r\n"]
[1.8739, "o", "- users\r\n"]
[1.8739, "o", "Введите команду: "]
[2.6777, "o", "create_table users name:str\r\n"]
[2.6784, "o", "Ошибка: Таблица \"users\" уже существует.\r\n"]
[2.6785, "o", "Введите команду: "]
[3.4836, "o", "drop_table users\r\n"]
[3.4856, "o", "Таблица \"users\" успешно удалена.\r\n"]
[3.4857, "o", "Введите команду: "]
[4.2893, "o", "list_tables\r\n"]
[4.2896, "o", "Введите команду: "]
[5.09, "o", "drop_table products\r\n"]
[5.0903, "o", "Ошибка: Таблица \"products\" не существует.\r\n"]
[5.0903, "o", "Введите команду: "]
[5.8913, "o", "exit\r\n"]
