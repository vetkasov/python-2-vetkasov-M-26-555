[0.8743, "o", "***Операции с данными***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> insert into <имя_таблицы> values (<значение1>, ...) - создать запись.\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\n<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r\n<command> info <имя_таб"]
[0.8744, "o", "лицы> - вывести информацию о таблице.\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n"]
[0.8744, "o", "Введите команду: "]
[1.6796, "o", "create_table users name:str age:int is_active:bool\r\n"]
[1.6822, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\nВведите команду: "]
[2.4869, "o", "insert into users values (\"Sergei\", 28, true)\r\n"]
[2.4887, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[2.4887, "o", "Введите команду: "]
[3.2926, "o", "insert into users values (\"Ivanov, Ivan\",22,FALSE)\r\n"]
[3.2947, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\nВведите команду: "]
[4.0982, "o", "select from users\r\n"]
[4.3876, "o", "+----+--------------+-----+-----------+\r\n| ID |     name     | age | is_active |\r\n+----+--------------+-----+-----------+\r\n| 1  |    Sergei    |  28 |    True   |\r\n| 2  | Ivanov, Ivan |  22 |   False   |\r\n+----+--------------+-----+-----------+\r\nВведите команду: "]
[5.1928, "o", "select from users where age = 28\r\n"]
[5.194, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[5.1941, "o", "Введите команду: "]
[5.9993, "o", "update users set age = 29 where name = \"Sergei\"\r\n"]
[6.0012, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\nВведите команду: "]
[6.8063, "o", "select from users where ID = 1\r\n"]
[6.8073, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[6.8073, "o", "Введите команду: "]
[7.6125, "o", "insert into users values (\"Invalid\", \"28\", true)\r\n"]
[7.613, "o", "Некорректное значение: 28. Попробуйте снова.\r\n"]
[7.6131, "o", "Введите команду: "]
[8.4158, "o", "delete from users where ID = 1\r\n"]
[8.4178, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\nВведите команду: "]
[9.2201, "o", "info users\r\n"]
[9.2204, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 1\r\n"]
[9.2205, "o", "Введите команду: "]
[10.0256, "o", "drop_table users\r\n"]
[10.0269, "o", "Таблица \"users\" успешно удалена.\r\n"]
