[0.007376, "o", "\r\nПервая рабочая версия после uv init: проверка настройки и запуска.\r\n\r\n$ cat pyproject.toml\r\n"]
[0.010461, "o", "[project]\r\nname = \"project-2-vetkasov-m-26-555\"\r\nversion = \"0.1.0\"\r\ndescription = \"Учебная консольная база данных, группа M-26-555\"\r\nreadme = \"README.md\"\r\nauthors = [\r\n    { name = \"arseny\", email = \"<author-email>\" }\r\n]\r\nrequires-python = \">=3.12\"\r\ndependencies = []\r\n\r\n[project.scripts]\r\ndatabase = \"primitive_db.main:main\"\r\nproject = \"primitive_db.main:main\"\r\n\r\n[build-system]\r\nrequires = [\"uv_build>=0.11.17,<0.12.0\"]\r\nbuild-backend = \"uv_build\"\r\n\r\n[tool.uv.build-backend]\r\nmodule-name = \"primitive_db\"\r\n"]
[2.018405, "o", "\r\n$ cat src/primitive_db/main.py\r\n"]
[2.024196, "o", "#!/usr/bin/env python3\r\n\"\"\"Точка входа учебного проекта базы данных.\"\"\"\r\n\r\n\r\ndef main():\r\n    \"\"\"Сообщить об успешном запуске проекта.\"\"\"\r\n    print(\"DB project is running!\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[2.024558, "o", "\r\n$ test ! -s src/primitive_db/__init__.py\r\n"]
[2.024634, "o", "Пустой __init__.py: проверка пройдена.\r\n"]
[4.032823, "o", "\r\n$ uv sync\r\n"]
[4.063919, "o", "Resolved 1 package in 7ms\r\n"]
[4.068595, "o", "Checked 1 package in 1ms\r\n"]
[4.071084, "o", "\r\n$ uv run python -m primitive_db.main\r\n"]
[4.097562, "o", "DB project is running!\r\n"]
[6.107734, "o", "\r\n$ uv run database\r\n"]
[6.149182, "o", "DB project is running!\r\n"]
[8.159845, "o", "\r\n$ uv run project\r\n"]
[8.198784, "o", "DB project is running!\r\n"]
